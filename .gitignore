# Deny by default at the repository root.
/*

!/.github/
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/chord-2go-spotify.spec
!/pyproject.toml
!/requirements-build.txt
!/payload/
!/scripts/
!/src/
!/tests/

# Generated and local files.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.DS_Store
/.coverage
/.mypy_cache/
/.pytest_cache/
/.ruff_cache/
/.venv/
/build/
/dist/
/src/chord_2go_spotify/data/*.tar.gz

# Never publish opaque or analysis artifacts.
**/*.apk
**/*.bin
**/*.dec
**/*.dll
**/*.elf
**/*.exe
**/*.img
**/*.iso
**/*.nupkg
**/*.so
**/*.tgz
**/*.xapk
**/*.zip
**/*capture*
**/*credential*
**/*firmware*
**/*playplay*
**/*secret*
**/*token*
